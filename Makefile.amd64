# Makefile.amd64 - the 64-bit build, during the port.
#
# Deliberately separate from the main Makefile rather than a set of ifeqs
# inside it. The 32-bit build is the one that currently works end to end,
# and the port takes a while; breaking `make` on day one to start it would
# mean no working reference to test against for as long as the port lasts.
# When the 64-bit tree can do what the 32-bit tree can, this collapses back
# into Makefile and the ARCH split goes with it.
#
#   make -f Makefile.amd64            build the ISO
#   make -f Makefile.amd64 test       boot it and check the machine state
#   make -f Makefile.amd64 run        boot it interactively

CC = gcc
AS = nasm
LD = ld

BUILD_DIR = build64
ISO_DIR   = iso64
KERNEL    = $(BUILD_DIR)/novaris64.bin
ISO       = novaris64.iso

# -mcmodel=kernel: the kernel is linked in the top 2GB, so a 32-bit
#   sign-extended displacement reaches every symbol. It pairs with the
#   KERNEL_VMA in linker64.ld and neither is correct without the other.
# -mno-red-zone: the 128 bytes below rsp that the System V ABI lets leaf
#   functions use without adjusting the stack. Hardware interrupts push
#   onto the same stack without knowing about it, so leaving this on
#   corrupts a leaf function's locals at the worst possible moment - and
#   only sometimes, which is the kind of bug that costs a week.
# -mno-sse -mno-mmx: the kernel must not touch xmm at all, which is why
#   Linux builds itself the same way. Linux's syscall ABI preserves every
#   register except rax, rcx and r11 - xmm included - and glibc's string
#   and memory routines keep live data there across a syscall. A kernel
#   compiled with SSE lets gcc emit an xmm move for something as ordinary
#   as a struct assignment, which would corrupt the caller's registers
#   occasionally and unreproducibly. boot64.s still enables CR4.OSFXSR,
#   because ring 3 very much does use SSE.
# -MMD -MP: emit a .d file per object listing the headers it included, and
#   give each header a phony rule so deleting one does not break the build.
#   Without this, editing a header rebuilds nothing - the object files only
#   depend on their .c. That is not a hypothetical: a syscall number was
#   changed in include/syscall64.h during Milestone 50 to check that the
#   test would catch it, the test passed, and the reason it passed was
#   that the change had never been compiled.
CFLAGS = -std=gnu99 -ffreestanding -fno-builtin -fno-stack-protector \
         -fno-pic -fno-pie -m64 -mcmodel=kernel -mno-red-zone \
         -mno-sse -mno-mmx \
         -Wall -Wextra -O2 -Iinclude -MMD -MP

# -w+error=label-orphan turns "label alone on a line" into an error. NASM
# accepts an unrecognised mnemonic as a label definition, so a 64-bit
# instruction it does not know - `lretq`, say, which is a gas spelling -
# assembles to nothing at all and execution falls through to the next
# function. That cost a debugging session here; it is an error now.
ASFLAGS = -f elf64 -w+error=label-orphan
LDFLAGS = -m elf_x86_64 -T linker64.ld -nostdlib -z max-page-size=0x1000 -z noexecstack

OBJS = $(BUILD_DIR)/boot64.o \
       $(BUILD_DIR)/isr64.o \
       $(BUILD_DIR)/syscall64_asm.o \
       $(BUILD_DIR)/syscall64.o \
       $(BUILD_DIR)/gdt64.o \
       $(BUILD_DIR)/idt64.o \
       $(BUILD_DIR)/serial64.o \
       $(BUILD_DIR)/pmm64.o \
       $(BUILD_DIR)/paging64.o \
       $(BUILD_DIR)/vmspace64.o \
       $(BUILD_DIR)/sched64.o \
       $(BUILD_DIR)/elf64.o \
       $(BUILD_DIR)/uspace64.o \
       $(BUILD_DIR)/pe64.o \
       $(BUILD_DIR)/win32_64.o \
       $(BUILD_DIR)/pe64_blob.o \
       $(BUILD_DIR)/dlllib64_blob.o \
       $(BUILD_DIR)/dlluser64_blob.o \
       $(BUILD_DIR)/loader64_blob.o \
       $(BUILD_DIR)/thread64_blob.o \
       $(BUILD_DIR)/futex64_blob.o \
       $(BUILD_DIR)/signal64_blob.o \
       $(BUILD_DIR)/signal64.o \
       $(BUILD_DIR)/fs64_blob.o \
       $(BUILD_DIR)/mmapfile64_blob.o \
       $(BUILD_DIR)/ramfs64.o \
       $(BUILD_DIR)/initrd64.o \
       $(BUILD_DIR)/hello64_blob.o \
       $(BUILD_DIR)/glibc64_blob.o \
       $(BUILD_DIR)/kheap64.o \
       $(BUILD_DIR)/kstring.o \
       $(BUILD_DIR)/kmain64.o

.PHONY: all iso run test clean

all: iso

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/boot64.o: boot/boot64.s | $(BUILD_DIR)
	$(AS) $(ASFLAGS) $< -o $@

$(BUILD_DIR)/isr64.o: kernel/isr64.s | $(BUILD_DIR)
	$(AS) $(ASFLAGS) $< -o $@

# Named _asm so it does not collide with syscall64.c's object file.
$(BUILD_DIR)/syscall64_asm.o: kernel/syscall64.s | $(BUILD_DIR)
	$(AS) $(ASFLAGS) $< -o $@

# A real static x86-64 Linux executable, built by the host toolchain and
# embedded in the kernel image. There is no filesystem in the 64-bit tree
# yet, so this is how a program gets in; the ELF itself is ordinary and
# knows nothing about Novaris.
$(BUILD_DIR)/hello64.elf: userland/hello64.s | $(BUILD_DIR)
	$(AS) -f elf64 $< -o $(BUILD_DIR)/hello64.o
	$(LD) -m elf_x86_64 -o $@ $(BUILD_DIR)/hello64.o
	@file $@ | grep -q "ELF 64-bit" \
	    || (echo "ERROR: $@ is not a 64-bit ELF"; false)

# A thread, made with raw clone(2). Static and libc-free for the same
# reason hello64.s is: what is being tested is the syscall, not the CRT.
$(BUILD_DIR)/thread64.elf: userland/thread64.s | $(BUILD_DIR)
	$(AS) -f elf64 $< -o $(BUILD_DIR)/thread64.o
	$(LD) -m elf_x86_64 -o $@ $(BUILD_DIR)/thread64.o

$(BUILD_DIR)/thread64_blob.c: $(BUILD_DIR)/thread64.elf userland/embed64.py
	python3 userland/embed64.py $< $@ thread64_elf

$(BUILD_DIR)/thread64_blob.o: $(BUILD_DIR)/thread64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

# Maps a file and reads it through the mapping - how a loader loads.
$(BUILD_DIR)/mmapfile64.elf: userland/mmapfile64.s | $(BUILD_DIR)
	$(AS) -f elf64 $< -o $(BUILD_DIR)/mmapfile64.o
	$(LD) -m elf_x86_64 -o $@ $(BUILD_DIR)/mmapfile64.o

$(BUILD_DIR)/mmapfile64_blob.c: $(BUILD_DIR)/mmapfile64.elf userland/embed64.py
	python3 userland/embed64.py $< $@ mmapfile64_elf

$(BUILD_DIR)/mmapfile64_blob.o: $(BUILD_DIR)/mmapfile64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

# Ordinary POSIX file I/O, so it runs against a real filesystem on the
# host and a RAM one on the guest, and both have to agree.
$(BUILD_DIR)/fs64.elf: userland/fs64.s | $(BUILD_DIR)
	$(AS) -f elf64 $< -o $(BUILD_DIR)/fs64.o
	$(LD) -m elf_x86_64 -o $@ $(BUILD_DIR)/fs64.o

$(BUILD_DIR)/fs64_blob.c: $(BUILD_DIR)/fs64.elf userland/embed64.py
	python3 userland/embed64.py $< $@ fs64_elf

$(BUILD_DIR)/fs64_blob.o: $(BUILD_DIR)/fs64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

# Catches SIGSEGV and rewrites RIP - Wine's exception dispatch in
# miniature, and the reason the frame layout has to be Linux's exactly.
$(BUILD_DIR)/signal64.elf: userland/signal64.s | $(BUILD_DIR)
	$(AS) -f elf64 $< -o $(BUILD_DIR)/signal64_user.o
	$(LD) -m elf_x86_64 -o $@ $(BUILD_DIR)/signal64_user.o

$(BUILD_DIR)/signal64_blob.c: $(BUILD_DIR)/signal64.elf userland/embed64.py
	python3 userland/embed64.py $< $@ signal64_elf

$(BUILD_DIR)/signal64_blob.o: $(BUILD_DIR)/signal64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

# Two threads handing off through a futex, with no spin to fall back on.
$(BUILD_DIR)/futex64.elf: userland/futex64.s | $(BUILD_DIR)
	$(AS) -f elf64 $< -o $(BUILD_DIR)/futex64.o
	$(LD) -m elf_x86_64 -o $@ $(BUILD_DIR)/futex64.o

$(BUILD_DIR)/futex64_blob.c: $(BUILD_DIR)/futex64.elf userland/embed64.py
	python3 userland/embed64.py $< $@ futex64_elf

$(BUILD_DIR)/futex64_blob.o: $(BUILD_DIR)/futex64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/hello64_blob.c: $(BUILD_DIR)/hello64.elf userland/embed64.py
	python3 userland/embed64.py $< $@ hello64_elf

$(BUILD_DIR)/hello64_blob.o: $(BUILD_DIR)/hello64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

# The same idea one step harder: a C program linked against real glibc,
# built by the host compiler with no Novaris involvement at all. Getting
# this to run means implementing what glibc's startup demands, which is
# a great deal more than three syscalls.
#
# -static because there is no dynamic loader here yet, and no filesystem
# for it to read a .so from.
$(BUILD_DIR)/hello_glibc64.elf: userland/hello_glibc64.c | $(BUILD_DIR)
	gcc -static -O2 -o $@ $<
	@file $@ | grep -q "statically linked" \
	    || (echo "ERROR: $@ is not static"; false)

$(BUILD_DIR)/glibc64_blob.c: $(BUILD_DIR)/hello_glibc64.elf userland/embed64.py
	python3 userland/embed64.py $< $@ glibc64_elf

$(BUILD_DIR)/glibc64_blob.o: $(BUILD_DIR)/glibc64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

# A real 64-bit Windows executable - the format chrome.exe is in. Built
# by mingw, importing from kernel32, linked at a Windows image base, and
# with no idea Novaris exists.
#
# -nostdlib and its own entry point: mingw's CRT startup wants far more
# of Win32 than exists here, and what is being tested is the loader and
# the calling convention rather than the CRT.
$(BUILD_DIR)/hello_pe64.exe: userland/hello_pe64.c | $(BUILD_DIR)
	x86_64-w64-mingw32-gcc -nostdlib -O2 -Wl,-e,entry -o $@ $< -lkernel32
	@file $@ | grep -q "PE32+" \
	    || (echo "ERROR: $@ is not a PE32+ image"; false)

$(BUILD_DIR)/pe64_blob.c: $(BUILD_DIR)/hello_pe64.exe userland/embed64.py
	python3 userland/embed64.py $< $@ pe64_exe

$(BUILD_DIR)/pe64_blob.o: $(BUILD_DIR)/pe64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

# A DLL and an executable that imports from it - the shape chrome.exe
# has, where the small .exe's real work lives in a library beside it.
#
# The exported data pointer in dlllib64.c is deliberate: it is what makes
# the linker emit a .reloc section, without which the loader's relocation
# path could not be tested at all.
$(BUILD_DIR)/dlllib64.dll: userland/dlllib64.c | $(BUILD_DIR)
	x86_64-w64-mingw32-gcc -shared -nostdlib -O2 -Wl,-e,DllEntry \
	    -Wl,--out-implib,$(BUILD_DIR)/dlllib64.lib -o $@ $< -lkernel32
	@objdump -p $@ | grep -q "Base Relocation Directory" \
	    || (echo "ERROR: $@ has no .reloc; the relocation test is void"; \
	        false)

$(BUILD_DIR)/dlluser64.exe: userland/dlluser64.c $(BUILD_DIR)/dlllib64.dll
	x86_64-w64-mingw32-gcc -nostdlib -O2 -Wl,-e,entry -o $@ $< \
	    $(BUILD_DIR)/dlllib64.lib -lkernel32

$(BUILD_DIR)/dlllib64_blob.c: $(BUILD_DIR)/dlllib64.dll userland/embed64.py
	python3 userland/embed64.py $< $@ dlllib64_dll

$(BUILD_DIR)/dlluser64_blob.c: $(BUILD_DIR)/dlluser64.exe userland/embed64.py
	python3 userland/embed64.py $< $@ dlluser64_exe

$(BUILD_DIR)/dlllib64_blob.o: $(BUILD_DIR)/dlllib64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/dlluser64_blob.o: $(BUILD_DIR)/dlluser64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

# Imports only kernel32: it finds its DLL by name at run time rather
# than through an import table, which is what LoadLibrary is for.
$(BUILD_DIR)/loader64.exe: userland/loader64.c | $(BUILD_DIR)
	x86_64-w64-mingw32-gcc -nostdlib -O2 -Wl,-e,entry -o $@ $< -lkernel32

$(BUILD_DIR)/loader64_blob.c: $(BUILD_DIR)/loader64.exe userland/embed64.py
	python3 userland/embed64.py $< $@ loader64_exe

$(BUILD_DIR)/loader64_blob.o: $(BUILD_DIR)/loader64_blob.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: kernel/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(KERNEL): $(OBJS) linker64.ld
	$(LD) $(LDFLAGS) -o $@ $(OBJS)
	@# A 64-bit kernel that GRUB cannot find a Multiboot header in fails
	@# with "no multiboot header found" and nothing else, so check here
	@# where the message can say which of the two things went wrong.
	@grub-file --is-x86-multiboot $@ \
	    || (echo "ERROR: $@ has no valid Multiboot header"; false)
	@echo "  built $@"

# The initrd, built with the same mkinitrd.py the 32-bit tree uses.
#
# It ships dlllib64.dll so that a program can load a library from a FILE
# rather than from bytes compiled into the kernel - which is the whole
# point of Milestone 54, and the thing every DLL beyond the test set will
# need.
INITRD_STAGE = $(BUILD_DIR)/initrd64
INITRD       = $(BUILD_DIR)/initrd64.img

# The host's dynamic loader and C library, so that a dynamically linked
# program has something to link against. Resolved rather than hardcoded:
# ld-linux-x86-64.so.2 is a symlink and the real file moves between
# distributions.
LD_SO  := $(shell readlink -f /lib64/ld-linux-x86-64.so.2)
LIBC   := $(shell readlink -f /lib/x86_64-linux-gnu/libc.so.6)
LIBGCC := $(shell readlink -f /lib/x86_64-linux-gnu/libgcc_s.so.1 2>/dev/null)

# An x86-64 Wine built out-of-tree beside the repository, if there is
# one. Two candidates because a git worktree sits four levels below the
# checkout it belongs to, and the build has to work from either.
# Override with `make -f Makefile.amd64 WINE64_LOADER=/path/to/wine`.
WINE64_LOADER ?= $(firstword $(wildcard \
    ../wine64-build/loader/wine ../../../../wine64-build/loader/wine))
WINE64_NTDLL  ?= $(firstword $(wildcard \
    ../wine64-build/dlls/ntdll/ntdll.so \
    ../../../../wine64-build/dlls/ntdll/ntdll.so))

$(INITRD): $(BUILD_DIR)/dlllib64.dll $(BUILD_DIR)/dynhello64.elf \
           userland/mkinitrd.py
	rm -rf $(INITRD_STAGE)
	mkdir -p $(INITRD_STAGE)
	cp $(BUILD_DIR)/dlllib64.dll $(INITRD_STAGE)/dlllib64.dll
	cp $(BUILD_DIR)/dynhello64.elf $(INITRD_STAGE)/dynhello64
	@# At the paths ld.so actually searches, which were read off its own
	@# trace rather than guessed: it tries /lib/x86_64-linux-gnu first.
	@# The filesystem matches whole paths, so a file at /libc.so.6 is
	@# invisible to a loader looking in /lib.
	mkdir -p $(INITRD_STAGE)/lib/x86_64-linux-gnu $(INITRD_STAGE)/lib64
	cp $(LD_SO) $(INITRD_STAGE)/lib64/ld-linux-x86-64.so.2
	cp $(LIBC)  $(INITRD_STAGE)/lib/x86_64-linux-gnu/libc.so.6
	@# ntdll.so needs libgcc_s for its unwinder. Copied unconditionally
	@# rather than only alongside Wine: it is small, and a missing
	@# dependency is a much more confusing failure than a spare file.
	@if [ -f "$(LIBGCC)" ]; then \
	    cp "$(LIBGCC)" $(INITRD_STAGE)/lib/x86_64-linux-gnu/libgcc_s.so.1; \
	 fi
	@# Wine's own loader, if a 64-bit Wine has been built beside the
	@# tree. Optional: the build must not depend on somebody having
	@# spent an hour compiling Wine, so this is copied when present and
	@# skipped when not, and the layer that runs it says which.
	@# ntdll.so goes beside it, because that is where Wine looks: it
	@# reads /proc/self/exe, takes the directory, and appends the
	@# library name. With the loader at /wine that is /ntdll.so.
	@if [ -x "$(WINE64_LOADER)" ]; then \
	    cp "$(WINE64_LOADER)" $(INITRD_STAGE)/wine; \
	    if [ -f "$(WINE64_NTDLL)" ]; then \
	        cp "$(WINE64_NTDLL)" $(INITRD_STAGE)/ntdll.so; \
	        echo "  initrd: including Wine's loader and ntdll.so"; \
	    else \
	        echo "  initrd: Wine loader without ntdll.so"; \
	    fi; \
	 else \
	    echo "  initrd: no Wine loader at $(WINE64_LOADER), skipping"; \
	 fi
	python3 userland/mkinitrd.py $(INITRD_STAGE) $@

# A dynamically linked program - the smallest thing that makes ld.so run.
$(BUILD_DIR)/dynhello64.elf: userland/dynhello64.c | $(BUILD_DIR)
	gcc -O2 -o $@ $<
	@file $@ | grep -q "dynamically linked" \
	    || (echo "ERROR: $@ is not dynamically linked"; false)

iso: $(KERNEL) $(INITRD)
	mkdir -p $(ISO_DIR)/boot/grub
	cp $(KERNEL) $(ISO_DIR)/boot/novaris64.bin
	cp $(INITRD) $(ISO_DIR)/boot/initrd64.img
	cp grub64.cfg $(ISO_DIR)/boot/grub/grub.cfg
	grub-mkrescue -o $(ISO) $(ISO_DIR) 2>/dev/null
	@echo "  built $(ISO)"

run: iso
	qemu-system-x86_64 -cdrom $(ISO) -serial stdio

# The bring-up test. kernel_main halts rather than exiting, so the run is
# bounded by `timeout` and judged by what reached the serial port.
test: iso
	@rm -f $(BUILD_DIR)/serial.log
	@timeout 30 qemu-system-x86_64 -cdrom $(ISO) -display none \
	    -serial file:$(BUILD_DIR)/serial.log -no-reboot >/dev/null 2>&1 || true
	@echo "--- serial ---"
	@cat $(BUILD_DIR)/serial.log 2>/dev/null || true
	@echo "--------------"
	@if ! grep -q "bring-up complete" $(BUILD_DIR)/serial.log 2>/dev/null; then \
	    echo "FAIL: the kernel did not reach the end of kernel_main"; exit 1; fi
	@if grep -q "FAIL" $(BUILD_DIR)/serial.log; then \
	    echo "FAIL: the machine is not in the state it should be"; exit 1; fi
	@echo "PASS: 64-bit long mode, higher half, multiboot handoff intact"
	@# The differential. userland/hello64.s is an ordinary static Linux
	@# executable, so the host can run the very same file the guest just
	@# ran. Checking the two agree is a much stronger statement than
	@# checking the guest printed something: it says this kernel
	@# implements Linux's ABI, rather than something shaped like it.
	@./$(BUILD_DIR)/hello64.elf > $(BUILD_DIR)/hello64.host.txt 2>/dev/null; \
	    echo $$? > $(BUILD_DIR)/hello64.host.status
	@grep -qFf $(BUILD_DIR)/hello64.host.txt $(BUILD_DIR)/serial.log \
	    || (echo "FAIL: the guest did not print what the host prints"; \
	        exit 1)
	@[ "`cat $(BUILD_DIR)/hello64.host.status`" = "42" ] \
	    || (echo "FAIL: the host run did not exit 42 either"; exit 1)
	@echo "PASS: the same ELF prints the same bytes, and exits 42, on both"
	@# The same differential for the glibc binary, which is the stronger
	@# of the two: its output is produced by printf, through stdio,
	@# after glibc's startup has set up TLS, read the auxv and
	@# initialised malloc. Every line matching means all of that agreed.
	@./$(BUILD_DIR)/hello_glibc64.elf > $(BUILD_DIR)/glibc64.host.txt \
	    2>/dev/null; echo $$? > $(BUILD_DIR)/glibc64.host.status
	@while read -r line; do \
	    grep -qF "$$line" $(BUILD_DIR)/serial.log \
	        || { echo "FAIL: guest never printed: $$line"; exit 1; }; \
	done < $(BUILD_DIR)/glibc64.host.txt
	@[ "`cat $(BUILD_DIR)/glibc64.host.status`" = "7" ] \
	    || (echo "FAIL: the host run of the glibc binary did not exit 7"; \
	        exit 1)
	@echo "PASS: real glibc prints the same bytes, and exits 7, on both"
	@# And the threaded one. This differential earned its place: run on
	@# Linux it exposed that the program was calling exit(60), which ends
	@# only the calling thread, where it meant exit_group(231). Novaris
	@# does not yet tell those apart, so the guest alone could not have
	@# caught it.
	@timeout 20 ./$(BUILD_DIR)/thread64.elf > $(BUILD_DIR)/thread64.host.txt \
	    2>/dev/null; echo $$? > $(BUILD_DIR)/thread64.host.status
	@grep -qFf $(BUILD_DIR)/thread64.host.txt $(BUILD_DIR)/serial.log \
	    || (echo "FAIL: the guest did not print what the host prints"; \
	        exit 1)
	@[ "`cat $(BUILD_DIR)/thread64.host.status`" = "23" ] \
	    || (echo "FAIL: the host run of the threaded binary did not exit 23"; \
	        exit 1)
	@echo "PASS: clone(2) behaves the same, and exits 23, on both"
	@# And the futex one, which is the strongest of the four: it blocks
	@# and is woken rather than spinning, so a kernel that faked
	@# FUTEX_WAIT could not produce this on either side.
	@timeout 20 ./$(BUILD_DIR)/futex64.elf > $(BUILD_DIR)/futex64.host.txt \
	    2>/dev/null; echo $$? > $(BUILD_DIR)/futex64.host.status
	@grep -qFf $(BUILD_DIR)/futex64.host.txt $(BUILD_DIR)/serial.log \
	    || (echo "FAIL: the guest did not print what the host prints"; \
	        exit 1)
	@[ "`cat $(BUILD_DIR)/futex64.host.status`" = "31" ] \
	    || (echo "FAIL: the host run of the futex binary did not exit 31"; \
	        exit 1)
	@echo "PASS: futex(2) blocks and wakes the same, and exits 31, on both"
	@# The signal one. This is the differential that matters most, because
	@# the frame layout is not something a guest-only test can check: a
	@# handler that reads uc_mcontext by Linux's offsets only works if the
	@# kernel wrote them there, and only Linux can confirm the offsets.
	@timeout 20 ./$(BUILD_DIR)/signal64.elf > $(BUILD_DIR)/signal64.host.txt \
	    2>/dev/null; echo $$? > $(BUILD_DIR)/signal64.host.status
	@grep -qFf $(BUILD_DIR)/signal64.host.txt $(BUILD_DIR)/serial.log \
	    || (echo "FAIL: the guest did not print what the host prints"; \
	        exit 1)
	@[ "`cat $(BUILD_DIR)/signal64.host.status`" = "41" ] \
	    || (echo "FAIL: the host run of the signal binary did not exit 41"; \
	        exit 1)
	@echo "PASS: SIGSEGV is caught and resumed the same, and exits 41, on both"
	@# And the filesystem one. It writes under /tmp and unlinks what it
	@# made, so the host run leaves nothing behind.
	@timeout 20 ./$(BUILD_DIR)/fs64.elf > $(BUILD_DIR)/fs64.host.txt \
	    2>/dev/null; echo $$? > $(BUILD_DIR)/fs64.host.status
	@grep -qFf $(BUILD_DIR)/fs64.host.txt $(BUILD_DIR)/serial.log \
	    || (echo "FAIL: the guest did not print what the host prints"; \
	        exit 1)
	@[ "`cat $(BUILD_DIR)/fs64.host.status`" = "53" ] \
	    || (echo "FAIL: the host run of the filesystem binary did not exit 53"; \
	        exit 1)
	@echo "PASS: files behave the same, and exit 53, on both"
	@# And the file-mapping one, which also checks that MAP_PRIVATE is
	@# private - a kernel sharing the frame instead of copying passes
	@# the contents check and fails this.
	@timeout 20 ./$(BUILD_DIR)/mmapfile64.elf \
	    > $(BUILD_DIR)/mmapfile64.host.txt 2>/dev/null; \
	    echo $$? > $(BUILD_DIR)/mmapfile64.host.status
	@grep -qFf $(BUILD_DIR)/mmapfile64.host.txt $(BUILD_DIR)/serial.log \
	    || (echo "FAIL: the guest did not print what the host prints"; \
	        exit 1)
	@[ "`cat $(BUILD_DIR)/mmapfile64.host.status`" = "61" ] \
	    || (echo "FAIL: the host run of the mmap binary did not exit 61"; \
	        exit 1)
	@echo "PASS: a mapped file reads the same, and exits 61, on both"
	@# The dynamic one. It runs against the host's own ld.so and libc -
	@# the very same files the guest has in its initrd - so agreement
	@# here means the kernel satisfied a dynamic loader it did not write
	@# and cannot influence.
	@timeout 20 ./$(BUILD_DIR)/dynhello64.elf \
	    > $(BUILD_DIR)/dynhello64.host.txt 2>/dev/null; \
	    echo $$? > $(BUILD_DIR)/dynhello64.host.status
	@grep -qFf $(BUILD_DIR)/dynhello64.host.txt $(BUILD_DIR)/serial.log \
	    || (echo "FAIL: the guest did not print what the host prints"; \
	        exit 1)
	@[ "`cat $(BUILD_DIR)/dynhello64.host.status`" = "67" ] \
	    || (echo "FAIL: the host run of the dynamic binary did not exit 67"; \
	        exit 1)
	@echo "PASS: a dynamically linked program runs the same, and exits 67, on both"

clean:
	rm -rf $(BUILD_DIR) $(ISO_DIR) $(ISO)

# The dependency files -MMD wrote. The dash matters on a clean tree, where
# none of them exist yet.
-include $(OBJS:.o=.d)
