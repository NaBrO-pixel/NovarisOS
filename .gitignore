# Build output. Everything here is regenerated by `make`.
build/
iso/
novaris.iso
serial.log
screenshot.png

# The 64-bit build, regenerated by `make -f Makefile.amd64`.
build64/
iso64/
novaris64.iso

# -fstack-usage output, produced when profiling kernel stack depth.
*.su
novaris-wine.iso

# Disk images (Milestone 32). Deliberately not build output - a disk is
# storage, and `make` does not rebuild it - but not something to commit
# either: novaris-disk.img is whatever you have written to it, and
# novaris-wine-disk.img is a couple of hundred megabytes of somebody
# else's Wine prefix.
*.img
__pycache__/

# Claude Code's local settings. Machine-specific, and it holds the
# permission allow-list - which is exactly the sort of file that ends up
# with a credential in it, so it must never be committable.
.claude/settings.local.json
.claude/worktrees/
